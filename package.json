{
  "name": "map-aesthetic",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An agent skill for cartographic design and visual refinement across web map SDKs.",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite demo --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build demo --outDir ../dist --emptyOutDir",
    "preview": "vite preview demo --outDir ../dist --host 127.0.0.1 --port 4173 --strictPort",
    "test:browser": "playwright test",
    "test:node": "node --test tests-node/restore.test.mjs tests-node/case-server.test.mjs tests-node/mapbox-variant.test.mjs",
    "case:serve": "node cases/serve.mjs",
    "case:verify": "node scripts/verify_cases.mjs"
  },
  "dependencies": { "leaflet": "1.9.4", "maplibre-gl": "6.16.0" },
  "devDependencies": { "@playwright/test": "1.64.1", "vite": "8.3.5" }
}
