{
  "schemaVersion": "1.1",
  "id": "cultural-atlas",
  "name": "Cultural Atlas",
  "mode": "light",
  "intent": "public",
  "ui": {
    "background": "#EEF1F0",
    "surface": "#FFFFFF",
    "text": "#23282B",
    "mutedText": "#5F6B68",
    "border": "#DDE2E0",
    "accent": "#2F7068",
    "accentText": "#FFFFFF",
    "focusRing": "#2F7068",
    "fontFamily": "system-ui, -apple-system, 'Microsoft YaHei', 'PingFang SC', sans-serif",
    "radiusPx": 4,
    "spacingPx": 8
  },
  "cartography": {
    "land": "#E8EBE9",
    "water": "#D2E2DE",
    "park": "#E0E8D6",
    "road": "#FBFAF4",
    "roadCasing": "#DCD8CD",
    "boundary": "#CFC7B6",
    "label": "#4F5A57",
    "labelHalo": "#F3F5F4",
    "categorical": [
      "#3F6FA3",
      "#4E9A76",
      "#C25A43",
      "#8A6CB0",
      "#C8902C",
      "#4F95A6"
    ],
    "sequential": [
      "#DEEFE9",
      "#A8CFC1",
      "#4F95A6",
      "#2F6E62"
    ],
    "diverging": {
      "ramp": [
        "#2F6E8C",
        "#8FBDD3",
        "#EFEFEA",
        "#D9A98C",
        "#A8542B"
      ],
      "midpoint": "mean"
    },
    "route": {
      "color": "#2F7068",
      "casingColor": "#FFFFFF",
      "widthPx": 4,
      "casingWidthPx": 7
    },
    "site": {
      "color": "#3F6FA3",
      "radiusPx": 8,
      "strokeColor": "#FBFAF4",
      "strokeWidthPx": 2
    },
    "selection": {
      "color": "#2B2F33",
      "haloColor": "#FBFAF4",
      "widthPx": 3,
      "keepClassVisible": true
    },
    "area": {
      "fillOpacity": 0.55,
      "boundaryColor": "#CFC7B6",
      "boundaryWidthPx": 1
    },
    "missing": {
      "color": "#C8C8C1",
      "fillOpacity": 0.5,
      "pattern": "diagonal-hatch",
      "label": "无数据"
    },
    "classes": [
      { "id": "博物馆", "color": "#3F6FA3" },
      { "id": "图书馆", "color": "#4E9A76" },
      { "id": "剧院", "color": "#C25A43" },
      { "id": "美术馆", "color": "#8A6CB0" },
      { "id": "书店", "color": "#C8902C" },
      { "id": "非遗驿站", "color": "#4F95A6" }
    ],
    "states": {
      "hover": "#2F7068",
      "alert": "#B3261E",
      "disabled": "#9AA4A0"
    },
    "labels": {
      "sizePx": 12,
      "haloWidthPx": 2,
      "density": "balanced"
    },
    "scale": {
      "detailBelowMpp": 8,
      "overviewAboveMpp": 24
    }
  }
}
